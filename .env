# Copier ce fichier en .env (même dossier) et adapter les valeurs.
# .env est ignoré par Git (.gitignore) — ne jamais versionner de vrais secrets.

# --- Environnement ---
# 'local' : le secret JWT par défaut est toléré avec un avertissement dans les logs.
# 'production' : l'appli refuse de démarrer si JWT_SECRET n'est pas défini.
APP_ENV=local

# --- Base de données MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smarthire_ai
DB_USER=root
DB_PASS=

# --- JWT ---
# Générer une vraie valeur aléatoire, par ex. :
#   php -r "echo bin2hex(random_bytes(32));"
# Ne JAMAIS laisser la valeur par défaut de config/jwt.php en production.
JWT_SECRET=change-this-to-a-random-64-char-string

# --- Frontend ---
# Utilisé pour construire les liens envoyés par email (reset password, etc.)
FRONTEND_URL=http://localhost/smarthire-frontend

# --- Envoi d'email (mot de passe oublié) ---
# Laisser MAIL_HOST vide en dev : les emails sont alors simplement écrits
# dans les logs PHP (voir services/Mailer.php) au lieu d'être réellement envoyés.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@smarthire.ai
MAIL_FROM_NAME="SmartHire AI"

# --- Microservice IA ---
AI_SERVICE_URL=http://127.0.0.1:5000
